# App connection. On Supabase/Vercel use the transaction pooler: port 6543 + ?pgbouncer=true&connection_limit=1
DATABASE_URL=""
# Direct/session connection (port 5432), used only by `prisma migrate`. Locally it can equal DATABASE_URL.
DIRECT_URL=""
# 32+ random characters
JWT_SECRET=""
GOOGLE_CLIENT_ID=""
GEMINI_API_KEY=""

# Razorpay: dashboard.razorpay.com -> Settings -> API Keys. Use rzp_test_ keys until go-live.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard -> Settings -> Webhooks: URL https://<your-domain>/api/payments/webhook,
# events payment.captured and order.paid. Paste the secret you set there.
RAZORPAY_WEBHOOK_SECRET=""

# Optional: ISO date when the 30% early-bird offer closes (drives the countdown). Unset = open, no timer.
OFFER_ENDS_AT="2026-11-15T23:59:59+05:30"
